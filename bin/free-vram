#!/usr/bin/env bash
# free-vram — reclaim GPU memory held by leftover Chrome/Chromium and Steam.
#
# Works with native installs and with flatpak, and with the Bazzite/SteamOS
# autostart units.  Touches ONLY:
#   * Chrome / Chromium processes (native) and flatpak Chrome / Chromium
#   * Steam (client, webhelpers, pressure-vessel) and app-steam@autostart
# It never touches the compositor, the shell or the rest of the session.
#
# Usage:
#   free-vram                kill Chrome + Steam, then report the VRAM delta
#   free-vram --dry-run      show what would be killed, change nothing
#   free-vram --status       print VRAM + current holders, kill nothing
#   free-vram --no-chrome    Steam only
#   free-vram --no-steam     Chrome only
#   free-vram --timeout N    seconds to wait for a clean exit (default 10)
#   free-vram -h|--help
#
# Exit status: 0 = everything targeted is gone, 1 = something survived.

set -uo pipefail

STEAM_UNIT="app-steam@autostart.service"
FLATPAK_CHROME_IDS=(com.google.Chrome org.chromium.Chromium)
NATIVE_CHROME_NAMES=(chrome chromium chromium-browser google-chrome google-chrome-stable)

TIMEOUT=10
DO_CHROME=1
DO_STEAM=1
DRY_RUN=0
STATUS_ONLY=0

usage() {
  cat <<'EOF'
free-vram — reclaim GPU memory held by leftover Chrome/Chromium and Steam.

Usage: free-vram [options]

  (no options)     kill Chrome + Steam, then report the VRAM delta
  --dry-run        show what would be killed, change nothing
  --status         print VRAM + current holders, kill nothing
  --no-chrome      Steam only
  --no-steam       Chrome only
  --timeout N      seconds to wait for a clean exit (default 10)
  -h, --help       this text

Exit status: 0 = everything targeted is gone, 1 = something survived.
EOF
  exit "${1:-0}"
}

while (($#)); do
  case "$1" in
    --dry-run)   DRY_RUN=1 ;;
    --status)    STATUS_ONLY=1 ;;
    --no-chrome) DO_CHROME=0 ;;
    --no-steam)  DO_STEAM=0 ;;
    --timeout)   TIMEOUT="${2:?--timeout needs a value}"; shift ;;
    -h|--help)   usage 0 ;;
    *)           printf 'free-vram: unknown option %q (try --help)\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

# --- plumbing ---------------------------------------------------------------

if [[ -t 1 ]]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
  C_OK=""; C_WARN=""; C_DIM=""; C_OFF=""
fi

log()  { printf '%s\n' "$*"; }
warn() { printf '%s%s%s\n' "$C_WARN" "$*" "$C_OFF"; }

# systemctl --user and flatpak both need the runtime dir; sudo'd or cron'd
# invocations often lack it.
if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -d "${XDG_RUNTIME_DIR:-/nonexistent}" ]]; then
  if [[ -d "/run/user/$(id -u)" ]]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  fi
fi

if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
  printf 'free-vram: run as your normal user, not root (the targets belong to you)\n' >&2
  exit 2
fi

have() { command -v "$1" >/dev/null 2>&1; }

# --- GPU probe --------------------------------------------------------------

gpu_backend() {
  if have nvidia-smi && nvidia-smi --query-gpu=memory.total \
       --format=csv,noheader,nounits >/dev/null 2>&1; then
    echo nvidia; return
  fi
  if compgen -G '/sys/class/drm/card*/device/mem_info_vram_total' >/dev/null; then
    echo amdgpu; return
  fi
  echo none
}

vram_used() {
  local v f total=0 found=0
  if have nvidia-smi; then
    v=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null \
          | head -n1 | tr -d ' ')
    [[ $v =~ ^[0-9]+$ ]] && { echo "$v"; return; }
  fi
  for f in /sys/class/drm/card*/device/mem_info_vram_used; do
    [[ -r $f ]] || continue
    v=$(<"$f"); [[ $v =~ ^[0-9]+$ ]] || continue
    total=$((total + v)); found=1
  done
  ((found)) && echo $((total / 1048576))
  return 0
}

vram_total() {
  local v f total=0 found=0
  if have nvidia-smi; then
    v=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null \
          | head -n1 | tr -d ' ')
    [[ $v =~ ^[0-9]+$ ]] && { echo "$v"; return; }
  fi
  for f in /sys/class/drm/card*/device/mem_info_vram_total; do
    [[ -r $f ]] || continue
    v=$(<"$f"); [[ $v =~ ^[0-9]+$ ]] || continue
    total=$((total + v)); found=1
  done
  ((found)) && echo $((total / 1048576))
  return 0
}

gpu_name() {
  [[ $(gpu_backend) == nvidia ]] || return 0
  nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n1 \
    | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# Every process the driver says is holding VRAM, as "pid<TAB>MiB".
gpu_procs() {
  [[ $(gpu_backend) == nvidia ]] || return 0
  nvidia-smi 2>/dev/null | sed -n '/Processes:/,/^$/p' | grep -E '[0-9]+MiB' | while IFS= read -r line; do
    [[ $line =~ ([0-9]+)MiB ]] || continue
    local mib="${BASH_REMATCH[1]}" pid=""
    local after="${line#*|}"
    [[ $after =~ ([0-9]{2,}) ]] && pid="${BASH_REMATCH[1]}"
    [[ -n $pid ]] && printf '%s\t%s\n' "$pid" "$mib"
  done
}

# --- Chrome / Chromium ------------------------------------------------------

# native browser processes: the browser and its renderers share the same name
chrome_pids() {
  have pgrep || return 0
  local n
  for n in "${NATIVE_CHROME_NAMES[@]}"; do
    pgrep -u "$(id -u)" -x "$n" 2>/dev/null
  done | sort -un | grep -vx "$$" || true
}

flatpak_chrome_ids() {
  have flatpak || return 0
  local id
  for id in "${FLATPAK_CHROME_IDS[@]}"; do
    flatpak info "$id" >/dev/null 2>&1 && printf '%s\n' "$id"
  done
}

# running flatpak instances, as "instance<TAB>app-id"
flatpak_chrome_instances() {
  have flatpak || return 0
  local ps ids
  ps=$(flatpak ps --columns=instance,application 2>/dev/null) || return 0
  [[ -n $ps ]] || return 0
  ids=$(flatpak_chrome_ids)
  [[ -n $ids ]] || return 0
  printf '%s\n' "$ps" | awk -v ids="$ids" '
    BEGIN { n=split(ids, a, "\n") }
    { for (i=1; i<=n; i++) if ($2 == a[i]) { print; break } }'
}

# Instance scopes still registered with the user manager (flatpak Chrome).
chrome_scopes() {
  have systemctl || return 0
  local id pat out
  out=$(systemctl --user list-units --type=scope --state=active --no-legend --no-pager 2>/dev/null) || return 0
  for id in "${FLATPAK_CHROME_IDS[@]}"; do
    pat="app-flatpak-${id//./\\.}-[0-9]+\.scope"
    printf '%s\n' "$out" | grep -oE "$pat"
  done | sort -u || true
}

# Autostart units generated from the browser's exported .desktop file.
chrome_units() {
  have systemctl || return 0
  systemctl --user list-units --type=service --state=active --no-legend --no-pager 2>/dev/null \
    | grep -oE 'app-(flatpak-)?com\.google\.Chrome@[A-Za-z0-9]+\.service|app-(flatpak-)?org\.chromium\.Chromium@[A-Za-z0-9]+\.service' \
    | sort -u || true
}

chrome_count() {
  local n f
  n=$(chrome_pids | wc -l)
  f=$(flatpak_chrome_instances | wc -l)
  ((n == 0 && f == 0)) && n=$(chrome_scopes | wc -l)
  echo $((n + f))
}

chrome_summary() {
  printf '%s native pid(s), %s flatpak instance(s)\n' \
    "$(chrome_pids | wc -l)" "$(flatpak_chrome_instances | wc -l)"
}

stop_chrome() {
  local pids ids instances scopes units u

  pids=$(chrome_pids)
  ids=$(flatpak_chrome_ids)
  instances=$(flatpak_chrome_instances)
  scopes=$(chrome_scopes)
  units=$(chrome_units)

  if [[ -z $pids && -z $instances && -z $scopes && -z $units ]]; then
    log "[chrome] not running"
    return 0
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    [[ -n $instances ]] && log "[chrome] would stop flatpak: $(tr '\n' ' ' <<<"$instances")"
    [[ -n $pids      ]] && log "[chrome] would kill native pids: $(tr '\n' ' ' <<<"$pids")"
    [[ -n $scopes    ]] && log "         scopes: $(tr '\n' ' ' <<<"$scopes")"
    [[ -n $units     ]] && log "         units:  $(tr '\n' ' ' <<<"$units")"
    return 0
  fi

  # flatpak kill sends SIGTERM to every instance -> Chrome saves state and exits
  if [[ -n $instances ]]; then
    log "[chrome] stopping flatpak (app ids: $(tr '\n' ' ' <<<"$ids"))"
    local id
    for id in $ids; do flatpak kill "$id" >/dev/null 2>&1 || true; done
  fi

  # native: SIGTERM the browser process; renderers follow it down
  if [[ -n $pids ]]; then
    log "[chrome] stopping native browser (pids: $(tr '\n' ' ' <<<"$pids"))"
    printf '%s\n' "$pids" | xargs -r kill -TERM 2>/dev/null || true
  fi

  if ! wait_count_zero "$TIMEOUT" chrome_count; then
    warn "[chrome] still alive after ${TIMEOUT}s -> SIGKILL"
    pids=$(chrome_pids)
    [[ -n $pids ]] && printf '%s\n' "$pids" | xargs -r kill -9 2>/dev/null || true
    while IFS= read -r u; do
      [[ -n $u ]] && systemctl --user kill -s SIGKILL "$u" >/dev/null 2>&1
    done <<<"$(chrome_scopes)"
    wait_count_zero 3 chrome_count || true
  fi

  # Sweep whatever is left of the generated autostart units / scopes.
  for u in $units $(chrome_scopes); do
    systemctl --user stop "$u" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$u" >/dev/null 2>&1 || true
  done
  return 0
}

# --- Steam ------------------------------------------------------------------

# The Steam client tree: native, Bazzite-flavoured and steam-runtime processes.
steam_pids() {
  have pgrep || return 0
  pgrep -f -- '\.local/share/Steam/|steam-runtime-launcher-service|(^|/)steam( |$)|steamwebhelper' 2>/dev/null \
    | grep -vx "$$" || true
}

steam_count() { steam_pids | wc -l; }

steam_unit_active() {
  have systemctl && systemctl --user -q is-active "$STEAM_UNIT" >/dev/null 2>&1
}

stop_steam() {
  local n pids
  n=$(steam_count)

  if ! steam_unit_active && ((n == 0)); then
    log "[steam] not running"
    return 0
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    if steam_unit_active; then
      log "[steam] would stop ${STEAM_UNIT} (${n} process(es))"
    else
      log "[steam] would kill ${n} native process(es)"
    fi
    return 0
  fi

  if steam_unit_active; then
    log "[steam] stopping ${STEAM_UNIT} (${n} process(es))"
    # KillMode=control-group: systemd SIGTERMs the whole cgroup (steam.sh, the
    # 32-bit client, webhelpers, pressure-vessel), SIGKILLs after TimeoutStopSec.
    systemctl --user stop "$STEAM_UNIT" >/dev/null 2>&1 || true
  else
    log "[steam] stopping native client (${n} process(es))"
    pids=$(steam_pids)
    [[ -n $pids ]] && printf '%s\n' "$pids" | xargs -r kill -TERM 2>/dev/null || true
  fi

  if ! wait_count_zero "$TIMEOUT" steam_count; then
    warn "[steam] still alive after ${TIMEOUT}s -> SIGKILL"
    steam_pids | xargs -r kill -9 2>/dev/null || true
    wait_count_zero 3 steam_count || true
  fi
  return 0
}

# --- generic helpers --------------------------------------------------------

# wait_count_zero <seconds> <fn-that-prints-a-count>
wait_count_zero() {
  local secs=$1 fn=$2 i=0 limit=$(( $1 * 4 ))
  while ((i < limit)); do
    [[ "$("$fn")" -eq 0 ]] && return 0
    sleep 0.25
    i=$((i + 1))
  done
  [[ "$("$fn")" -eq 0 ]]
}

report_summary() {
  local used total name
  used=$(vram_used); total=$(vram_total); name=$(gpu_name)
  [[ -n $name ]] && log "GPU   : ${name}"
  if [[ $used =~ ^[0-9]+$ && $total =~ ^[0-9]+$ ]]; then
    log "VRAM  : ${used} / ${total} MiB used  ($((total - used)) MiB free)"
  else
    log "VRAM  : n/a (no supported GPU probe)"
  fi
}

report_holders() {
  local out pid mib comm
  [[ $(gpu_backend) == nvidia ]] || return 0
  # Capture first: piping straight into `grep -q` SIGPIPEs us under pipefail.
  out=$(gpu_procs)
  log "VRAM holders${C_DIM} (nvidia-smi)${C_OFF}:"
  if [[ -z $out ]]; then
    log "  ${C_DIM}none reported${C_OFF}"
    return 0
  fi
  while IFS=$'\t' read -r pid mib; do
    [[ -z $pid ]] && continue
    comm=$(ps -o comm= -p "$pid" 2>/dev/null || echo '?')
    printf '  %-8s %-38s %5s MiB\n' "$pid" "${comm:0:38}" "$mib"
  done < <(printf '%s\n' "$out" | sort -t$'\t' -k2 -nr)
}

# --- main -------------------------------------------------------------------

before=$(vram_used)

if [[ $STATUS_ONLY -eq 1 ]]; then
  report_summary
  log
  log "Chrome : $(chrome_summary)"
  if steam_unit_active; then
    log "Steam  : running (${STEAM_UNIT}, $(steam_count) pid(s))"
  elif (($(steam_count) > 0)); then
    log "Steam  : running (native, $(steam_count) pid(s))"
  else
    log "Steam  : not running"
  fi
  log
  report_holders
  exit 0
fi

[[ $DRY_RUN -eq 1 ]] && warn "dry run — nothing will be killed"
log
report_summary
log

if ((DO_CHROME)); then stop_chrome; fi
if ((DO_STEAM));  then stop_steam;  fi

if [[ $DRY_RUN -eq 1 ]]; then
  log
  report_holders
  exit 0
fi

log
after=$(vram_used)
report_summary
if [[ $before =~ ^[0-9]+$ && $after =~ ^[0-9]+$ ]]; then
  delta=$((before - after))
  if ((delta > 0)); then
    printf '%s freed %s MiB %s\n' "$C_OK" "$delta" "$C_OFF"
  else
    log "no VRAM freed"
  fi
fi

rc=0
if ((DO_CHROME)) && [[ "$(chrome_count)" -ne 0 ]]; then
  warn "chrome still has $(chrome_count) live pid/instance(s)"; rc=1
fi
if ((DO_STEAM)) && [[ "$(steam_count)" -ne 0 ]]; then
  warn "steam still has $(steam_count) live pid(s)"; rc=1
fi

if [[ -t 1 ]]; then
  log
  report_holders
fi

exit $rc
